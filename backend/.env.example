# Copy this file to ".env" and fill in your values

# Any long random text. Used to sign login tokens.
SECRET_KEY=change-this-to-a-long-random-text

# From https://console.anthropic.com  (needed for the "Parse with AI" feature)
ANTHROPIC_API_KEY=

# From Google Cloud Console (needed for "Sign in with Google"). Leave empty to skip.
GOOGLE_CLIENT_ID=

# Where your React app runs (for CORS)
FRONTEND_URL=http://localhost:5173
